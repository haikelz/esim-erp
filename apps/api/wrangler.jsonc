{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esim-erp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
    "traces": { "enabled": true },
    "logs": { "enabled": true }
  },
  "env": {
    "sandbox": {
      "vars": {
        "APP_ENV": "staging",
        "WEB_ORIGIN": "https://erp.example.invalid",
        "ALLOW_DEMO_PAYMENTS": "false"
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "143102",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    },
    "production": {
      "workers_dev": false,
      "routes": [{ "pattern": "api.esim-erp.ekel.dev", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        "WEB_ORIGIN": "https://esim-erp.ekel.dev",
        "ALLOW_DEMO_PAYMENTS": "true"
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "ERP_PROXY_SECRET",
          "ESIM_ENCRYPTION_KEY",
          "AUTOMATION_TOKEN"
        ]
      },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
